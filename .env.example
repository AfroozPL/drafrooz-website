# =====================================================================
# Dr. Afrooz Purarjomand — Personal Brand Website
# Copy this file to .env.local and fill in real values.
# In production, set the same vars in the Vercel project dashboard.
# =====================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_NOTIFICATION_EMAIL="afroozarjmand@gmail.com"

# --- Supabase ---
# Project URL from supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — NEVER expose to the browser. Used by admin client only.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe ---
# Use sk_test_* / pk_test_* during development.
# Payouts go to the bank account you add in the Stripe dashboard
# (Settings → Business → Bank accounts and currencies) — never in code.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook secret printed by `stripe listen` or shown when you create
# a real webhook endpoint at https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# --- Email: option A — Gmail (no domain needed) ---
# Google Account → Security → 2-Step Verification → App passwords.
# Booking emails are then sent from this Gmail address. Takes priority
# over Resend when both are set.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# --- Email: option B — Resend (needs a verified domain to email clients) ---
RESEND_API_KEY=""
# Once domain is verified at resend.com/domains
RESEND_FROM_EMAIL="Dr. Afrooz Purarjomand <hello@drafrooz.com>"

# --- Google Calendar + Meet ---
# OAuth 2.0 web app credentials from console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Refresh token obtained from a one-time consent (see scripts/google-auth.md)
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# --- Cron protection ---
# Generate with: openssl rand -hex 32
CRON_SECRET=""
